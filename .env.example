# cats-inbox 環境變數樣板(第七條:只列變數名,不放實際值)
# 🔴 secret 類一律留空——.env.example 進 git,帶了值就是把 secret 提交上去。
# 複製為 .env 後填入;.env 已在 .gitignore 內。
# 🔴 所有 app/config.py 讀取的變數都必須列在這裡,缺漏會讓 CI 失敗
#    (tests/test_skeleton.py::test_env_example_lists_every_variable_read_by_config)。

# ── 服務本身 ──
INBOX_BASE_PATH=/inbox
INBOX_LOG_LEVEL=INFO

# ── 資料庫(PostgreSQL 15;容器內以服務名連線,不對主機發布 port)──
INBOX_DB_URL=postgresql://cats_inbox@cats-inbox-pg:5432/cats_inbox
POSTGRES_DB=cats_inbox
POSTGRES_USER=cats_inbox
POSTGRES_PASSWORD=

# ── OIDC(Keycloak realm sporton;client 由 portal 依契約 §5 核發)──
# 🔴 ISSUER 必須是對外網址,絕不可改成內部位址(契約 §2.4)——
#    改了會讓 token 的 iss 驗證在正式環境靜默失敗。
INBOX_OIDC_ISSUER=https://catsapp.sporton.com.tw/auth/realms/sporton
# 容器內實際連線用的 base(discovery / JWKS / token 端點走這個)
INBOX_OIDC_INTERNAL_BASE=http://keycloak:8080/auth/realms/sporton
INBOX_OIDC_CLIENT_ID=cats-inbox
INBOX_OIDC_CLIENT_SECRET=

# ── session(契約 §10.2 聲明形態=cookie / 伺服器 session)──
INBOX_SESSION_SECRET=

# ── 首登開通(契約 §4.3:bootstrap 管理員 sub 清單,逗號分隔;每次登入比對)──
INBOX_BOOTSTRAP_ADMIN_SUBS=

# ── compose 紀律(對齊指南 §5.3:同目錄第二份 compose 是攻擊面,用機制封住)──
COMPOSE_FILE=docker-compose.yml
